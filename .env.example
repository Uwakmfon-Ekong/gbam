# `npm run setup:stellar` writes the Stellar values into .env.local for you.

# Stellar (testnet)
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_ASSET_CODE=USDC
NEXT_PUBLIC_ASSET_ISSUER=           # from setup:stellar
SPONSOR_SECRET=                     # from setup:stellar. Pays every fee + reserve. SERVER ONLY.
ISSUER_SECRET=                      # from setup:stellar. Only the setup script uses it.
FAUCET_AMOUNT=25                    # "Add test money" amount (stands in for a naira on-ramp)

# Product knobs
NEXT_PUBLIC_NGN_PER_USD=1500        # demo FX rate for Split
NEXT_PUBLIC_GIFT_EXPIRY_SECONDS=86400   # set to 120 on demo day to show "Take it back" live

# Claude (receipt reading). SERVER ONLY.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase (Project Settings → API). SERVER ONLY. Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: your production URL, for WhatsApp preview images
NEXT_PUBLIC_APP_URL=
